## Calculated the CBD size un slurry


variable    solvent_mass equal (1-${StL})*${dry_mass}/${StL}
variable    solvent_mass equal (1-0.5)*${dry_mass}/${StL}
variable    solvent_mass equal (1-0.5)*1e-07/${StL}
variable    solvent_mass equal (1-0.5)*1e-07/0.5
variable    CBD_vol_sol equal 1E+12*(${solvent_mass}+${CBD_mass})/(${Rho_cb_liq}*${n_CBD})
variable    CBD_vol_sol equal 1E+12*(1e-07+${CBD_mass})/(${Rho_cb_liq}*${n_CBD})
variable    CBD_vol_sol equal 1E+12*(1e-07+1e-08)/(${Rho_cb_liq}*${n_CBD})
variable    CBD_vol_sol equal 1E+12*(1e-07+1e-08)/(0.05*${n_CBD})
variable    CBD_vol_sol equal 1E+12*(1e-07+1e-08)/(0.05*21221)

