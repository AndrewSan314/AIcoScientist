LAMMPS (22 Jul 2025 - Update 4)
  using 4 OpenMP thread(s) per MPI task
package omp 4
using multi-threaded neighbor list subroutines
#Slurry : Active materials (NMC) + Carbon Binder Domain(CBD) (PVDF + Carbon black + NMP)

units           micro
dimension       3
atom_style      sphere
#atom_modify     map array
comm_modify vel yes
#newton off

## User inputs
include user_inputs.txt
## Number of AM type
variable nAM_part equal 10
variable nAM_eff equal 1      ## @input - number of different AM particle sizes
#print ${nAM_part} file nAM_part

## Diameters of AM particles in µm
variable    d_e_1 equal 5   ## @input

if "${nAM_eff} < 2" then "variable    d_e_2 equal 0.01"
variable    d_e_2 equal 0.01
if "${nAM_eff} >= 2" then "variable    d_e_2 equal 5   ## @input "

if "${nAM_eff} < 3" then "variable    d_e_3 equal 0.01"
variable    d_e_3 equal 0.01
if "${nAM_eff} >= 3" then "variable    d_e_3 equal 5   ## @input "

if "${nAM_eff} < 4" then "variable    d_e_4 equal 0.01"
variable    d_e_4 equal 0.01
if "${nAM_eff} >= 4" then "variable    d_e_4 equal 5  ## @input "

if "${nAM_eff} < 5" then "variable    d_e_5 equal 0.01"
variable    d_e_5 equal 0.01
if "${nAM_eff} >= 5" then "variable    d_e_5 equal 5  ## @input "

if "${nAM_eff} < 6" then "variable    d_e_6 equal 0.01"
variable    d_e_6 equal 0.01
if "${nAM_eff} >= 6" then "variable    d_e_6 equal 5 ## @input "

if "${nAM_eff} < 7" then "variable    d_e_7 equal 0.01"
variable    d_e_7 equal 0.01
if "${nAM_eff} >= 7" then "variable    d_e_7 equal 5 ## @input "

if "${nAM_eff} < 8" then "variable    d_e_8 equal 0.01"
variable    d_e_8 equal 0.01
if "${nAM_eff} >= 8" then "variable    d_e_8 equal 5 ## @input "

if "${nAM_eff} < 9" then "variable    d_e_9 equal 0.01"
variable    d_e_9 equal 0.01
if "${nAM_eff} >= 9" then "variable    d_e_9 equal 5 ## @input "

if "${nAM_eff} < 10" then "variable    d_e_10 equal 0.01"
variable    d_e_10 equal 0.01
if "${nAM_eff} >= 10" then "variable    d_e_10 equal 5 ## @input "

## ## AM particle size distribution (here fraction of number of particles - Ex: 0.2 - Important: the sum must be equal to 1)
variable p_AM1 equal 1  ##@input

if "${nAM_eff} < 2" then "variable    p_AM2 equal 0.00"
variable    p_AM2 equal 0.00
if "${nAM_eff} >= 2" then "variable p_AM2 equal 0   ##@input "

if "${nAM_eff} < 3" then "variable    p_AM3 equal 0.00"
variable    p_AM3 equal 0.00
if "${nAM_eff} >= 3" then "variable p_AM3 equal 0  ##@input "

if "${nAM_eff} < 4" then "variable    p_AM4 equal 0.00"
variable    p_AM4 equal 0.00
if "${nAM_eff} >= 4" then "variable p_AM4 equal 0  ##@input "

if "${nAM_eff} < 5" then "variable    p_AM5 equal 0.00"
variable    p_AM5 equal 0.00
if "${nAM_eff} >= 5" then "variable p_AM5 equal 0  ##@input "

if "${nAM_eff} < 6" then "variable    p_AM6 equal 0.00"
variable    p_AM6 equal 0.00
if "${nAM_eff} >= 6" then "variable p_AM6 equal 0   ##@input "

if "${nAM_eff} < 7" then "variable    p_AM7 equal 0.00"
variable    p_AM7 equal 0.00
if "${nAM_eff} >= 7" then "variable p_AM7 equal 0   ##@input "

if "${nAM_eff} < 8" then "variable    p_AM8 equal 0.00"
variable    p_AM8 equal 0.00
if "${nAM_eff} >= 8" then "variable p_AM8 equal 0   ##@input "

if "${nAM_eff} < 9" then "variable    p_AM9 equal 0.00"
variable    p_AM9 equal 0.00
if "${nAM_eff} >= 9" then "variable p_AM9 equal 0   ##@input "

if "${nAM_eff} < 10" then "variable    p_AM10 equal 0.00"
variable    p_AM10 equal 0.00
if "${nAM_eff} >= 10" then "variable p_AM10 equal 0   ##@input "

#Diameter solid (no solvent) CBD
variable    d_cb equal 1   ## @input - diameter of solid CBD agglomerates (after drying)
#Solid content
variable    StL  equal 0.5  ## @input - Solid content - Ex: 0.55

# Simulated electrode mass and weight percentages of AM and CBD
variable dry_mass equal 0.1/1E6 ## @input - Mass of the simulated electrode in g
variable ratio_AM equal 0.9 ## @input - AM wt.% - Ex: 0.94
variable ratio_CBD equal 0.1 ## @input - CBD wt.% (sum of carbon and binder) - Ex: 0.06
# Important : ratio_AM + ratio_CBD must be equal to 1

# Half of the size of the initial simulation box, were the AM and CBD particles are initially located randomly (before applying the FFs, which leads to the simulation box shrinkage)
variable size_ini_xy equal 200
variable level_thick equal 0 # 0: thinner, 1: thicker
if "${level_thick} == 0" then "variable size_ini_z equal 500"
variable size_ini_z equal 500
if "${level_thick} == 1" then "variable size_ini_z equal 1000"

##############################################################
# Parameters that depend on the Material types : @AM @CB @PVDF
##############################################################

# density
variable    Rho_AM equal 4.65 ## @change depend of the @AM material input : this refers to NMC-111
variable    ini_CBD_nano equal 0.5 ## Initial CBD nanoporosity. Experimentally it was found to be around 0.5 (DOI: 10.1002/aenm.201401612)
print ${ini_CBD_nano} file CBD_nanoporosity_ini
print 0.5 file CBD_nanoporosity_ini
0.5
variable    Rho_cb equal 1.8*v_ini_CBD_nano ## @change depend of the @CB and @PVDF materials : this refers to C65 and PVdF, both aving a density of ca. 1.8 g cm-3
variable    Rho_cb_liq equal 0.05  ## @change depend of the @CB , @PVDF and @Solvent materials : this value was taken by previous parametrization of the slurry model (DOI: 10.1002/batt.202000049)

## Diameter and density
include am_particles.txt
###Diameters

##Active Material

# Loop to assign diameters of each type
label loop
variable i loop ${nAM_part}
variable i loop 10
variable d_e_a$i equal v_d_e_$i
variable d_e_a1 equal v_d_e_$i
variable d_e_a1 equal v_d_e_1

# diameters of the particles
# variable d_a$i equal v_coef_exp*v_d_e_a$i

next i
jump am_particles.txt loop
variable i loop ${nAM_part}
variable i loop 10
variable d_e_a$i equal v_d_e_$i
variable d_e_a2 equal v_d_e_$i
variable d_e_a2 equal v_d_e_2

# diameters of the particles
# variable d_a$i equal v_coef_exp*v_d_e_a$i

next i
jump am_particles.txt loop
variable i loop ${nAM_part}
variable i loop 10
variable d_e_a$i equal v_d_e_$i
variable d_e_a3 equal v_d_e_$i
variable d_e_a3 equal v_d_e_3

# diameters of the particles
# variable d_a$i equal v_coef_exp*v_d_e_a$i

next i
jump am_particles.txt loop
variable i loop ${nAM_part}
variable i loop 10
variable d_e_a$i equal v_d_e_$i
variable d_e_a4 equal v_d_e_$i
variable d_e_a4 equal v_d_e_4

# diameters of the particles
# variable d_a$i equal v_coef_exp*v_d_e_a$i

next i
jump am_particles.txt loop
variable i loop ${nAM_part}
variable i loop 10
variable d_e_a$i equal v_d_e_$i
variable d_e_a5 equal v_d_e_$i
variable d_e_a5 equal v_d_e_5

# diameters of the particles
# variable d_a$i equal v_coef_exp*v_d_e_a$i

next i
jump am_particles.txt loop
variable i loop ${nAM_part}
variable i loop 10
variable d_e_a$i equal v_d_e_$i
variable d_e_a6 equal v_d_e_$i
variable d_e_a6 equal v_d_e_6

# diameters of the particles
# variable d_a$i equal v_coef_exp*v_d_e_a$i

next i
jump am_particles.txt loop
variable i loop ${nAM_part}
variable i loop 10
variable d_e_a$i equal v_d_e_$i
variable d_e_a7 equal v_d_e_$i
variable d_e_a7 equal v_d_e_7

# diameters of the particles
# variable d_a$i equal v_coef_exp*v_d_e_a$i

next i
jump am_particles.txt loop
variable i loop ${nAM_part}
variable i loop 10
variable d_e_a$i equal v_d_e_$i
variable d_e_a8 equal v_d_e_$i
variable d_e_a8 equal v_d_e_8

# diameters of the particles
# variable d_a$i equal v_coef_exp*v_d_e_a$i

next i
jump am_particles.txt loop
variable i loop ${nAM_part}
variable i loop 10
variable d_e_a$i equal v_d_e_$i
variable d_e_a9 equal v_d_e_$i
variable d_e_a9 equal v_d_e_9

# diameters of the particles
# variable d_a$i equal v_coef_exp*v_d_e_a$i

next i
jump am_particles.txt loop
variable i loop ${nAM_part}
variable i loop 10
variable d_e_a$i equal v_d_e_$i
variable d_e_a10 equal v_d_e_$i
variable d_e_a10 equal v_d_e_10

# diameters of the particles
# variable d_a$i equal v_coef_exp*v_d_e_a$i

next i
jump am_particles.txt loop

print "d_e_1: ${d_e_a1} " screen yes
d_e_1: 5 

if '${nAM_eff} >= 2' then 'print "d_e_2: ${d_e_a2} " screen yes'

if '${nAM_eff} >= 3' then 'print "d_e_3: ${d_e_a3} " screen yes'

if '${nAM_eff} >= 4' then 'print "d_e_4: ${d_e_a4} " screen yes'

if '${nAM_eff} >= 5' then 'print "d_e_5: ${d_e_a5} " screen yes'

if '${nAM_eff} >= 6' then 'print "d_e_6: ${d_e_a6} " screen yes'

